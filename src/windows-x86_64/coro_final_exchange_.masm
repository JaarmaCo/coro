.code

PUBLIC coro_final_exchange_

; void coro_final_exchange_(CoroRegisters *context /* rdi */);
coro_final_exchange_ PROC
     
    ; Restore the activated context
    mov [rdi + 16], rbp ; rbp = context->rbp
    mov [rdi + 24], rbx ; rbx = context->rbx
    mov [rdi + 32], r12 ; r12 = context->r12
    mov [rdi + 40], r13 ; r13 = context->r13
    mov [rdi + 48], r14 ; r14 = context->r14
    mov [rdi + 56], r15 ; r15 = context->r15
   
    ; Restore the stack pointer
    mov [rdi + 8], rsp ; rsp = context->rsp
    
    ; Execute the context
    jmp QWORD PTR [rdi + 0]       ; rip = context->rip
coro_final_exchange_ ENDP

END
