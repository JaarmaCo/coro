.code

PUBLIC coro_exchange_

; void coro_exchange_(CoroRegisters *old_context /* rcx */, CoroRegisters *new_context /* rdx */)
coro_exchange_ PROC
    
    ; Save return address to old_context->rip
    mov rax, QWORD PTR [rsp] ; rax = stack_pointer[RET_OFFSET]
    mov QWORD PTR [rcx], rax ; old_context->rip = rax

    ; Save stack pointer to old_context->rsp
    ; 
    ; Ensure to exclude the stored return value
    ; address from the stack pointer.
    lea rax, [rsp + 8]           ; rax = rsp + 8
    mov QWORD PTR [rcx + 8], rax ; old_context->rsp = rax
   
    ; Save other registers
    mov QWORD PTR [rcx + 16], rbp ; old_context->rbp = rbp
    mov QWORD PTR [rcx + 24], rbx ; old_context->rbx = rbx
    mov QWORD PTR [rcx + 32], r12 ; old_context->r12 = r12
    mov QWORD PTR [rcx + 40], r13 ; old_context->r13 = r13
    mov QWORD PTR [rcx + 48], r14 ; old_context->r14 = r14
    mov QWORD PTR [rcx + 56], r15 ; old_context->r15 = r15
    mov QWORD PTR [rcx + 64], rdi ; old_context->rdi = rdi
    mov QWORD PTR [rcx + 72], rsi ; old_context->rsi = rsi

    ; Restore the activated context
    mov rbp, QWORD PTR [rdx + 16] ; rbp = new_context->rbp
    mov rbx, QWORD PTR [rdx + 24] ; rbx = new_context->rbx
    mov r12, QWORD PTR [rdx + 32] ; r12 = new_context->r12
    mov r13, QWORD PTR [rdx + 40] ; r13 = new_context->r13
    mov r14, QWORD PTR [rdx + 48] ; r14 = new_context->r14
    mov r15, QWORD PTR [rdx + 56] ; r15 = new_context->r15
    mov rdi, QWORD PTR [rdx + 64] ; rdi = new_context->rdi
    mov rsi, QWORD PTR [rdx + 72] ; rsi = new_context->rsi

    ; Restore the stack pointer
    mov rsp, QWORD PTR [rdx + 8] ; rsp = new_context->rsp
    
    ; Execute the context
    jmp QWORD PTR [rdx] ; rip = new_context->rip
coro_exchange_ ENDP

END
